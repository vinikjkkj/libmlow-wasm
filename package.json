{
  "name": "libmlow-wasm",
  "version": "0.1.1",
  "description": "Fork of libopus-wasm with WebAssembly bindings for opus_mlow (Opus + SMPL/MLow) raw packet encode/decode.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edgardmessias/libmlow-wasm.git"
  },
  "homepage": "https://github.com/edgardmessias/libmlow-wasm#readme",
  "bugs": {
    "url": "https://github.com/edgardmessias/libmlow-wasm/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./discordjs": {
      "types": "./dist/discordjs.d.ts",
      "import": "./dist/discordjs.js"
    }
  },
  "files": [
    "dist/*.d.ts",
    "dist/*.d.ts.map",
    "dist/*.js",
    "dist/generated",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "pnpm build:wasm && tsc -p tsconfig.json && node scripts/copy-generated.mjs",
    "build:wasm": "node scripts/build-opus-mlow-wasm.mjs",
    "benchmark": "pnpm build && node scripts/benchmark-wasm.mjs",
    "codec-vectors": "node scripts/codec-vectors.mjs",
    "check-golden": "node scripts/check-golden.mjs",
    "clean": "rm -rf dist .cache",
    "docs:build": "node scripts/build-docs-site.mjs",
    "prepack": "pnpm build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "24.10.2",
    "@vitest/coverage-v8": "4.0.14",
    "typescript": "5.9.3",
    "vitest": "4.0.14"
  },
  "engines": {
    "node": ">=20"
  }
}
